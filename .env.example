# Copy to .env and fill in. Without these, vibewars runs exactly as before and
# simply does not record battle history.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a shared "house" key per provider, so the sandbox works for
# players who never connect their own. Real money on your account - both the
# key AND the model must be set for a provider to turn on, and it is capped
# per participant per round (server.js: HOUSE_CALLS_PER_ROUND) and globally
# across every lobby at once (HOUSE_MAX_CALLS_PER_WINDOW). Leave all of these
# blank and nothing changes: players just need their own key, same as before.
# Model ids move fast - check your provider's current docs rather than
# guessing, a stale id fails on every request.
HOUSE_OPENAI_API_KEY=
HOUSE_OPENAI_MODEL=
HOUSE_ANTHROPIC_API_KEY=
HOUSE_ANTHROPIC_MODEL=
HOUSE_GOOGLE_API_KEY=
HOUSE_GOOGLE_MODEL=
HOUSE_XAI_API_KEY=
HOUSE_XAI_MODEL=
